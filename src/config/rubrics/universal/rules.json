{
  "schemaVersion": "1.0.0",
  "rubricId": "UNIVERSAL_RETOPO_V1",
  "evaluationTypes": [
    "AUTOMATIC",
    "AI_VISUAL",
    "HYBRID",
    "MANUAL_REVIEW"
  ],
  "applicableModes": [
    "LOW_POLY_ONLY",
    "REFERENCE_COMPARISON"
  ],
  "rules": [
    {
      "id": "MH_NON_MANIFOLD",
      "dimensionId": "MESH_HEALTH",
      "name": "非流形结构",
      "description": "检测非流形边、异常多面连接及无法构成有效表面的拓扑关系。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "CRITICAL",
      "metrics": [
        "nonManifoldEdgeCount",
        "nonManifoldVertexCount"
      ],
      "scoreCriteria": {
        "0": "主体结构无效或无法正常解析。",
        "1": "大量非流形结构。",
        "2": "存在多处问题并影响编辑或导出。",
        "3": "存在少量可快速修复的问题。",
        "4": "仅有极少量低风险问题，且不位于主体区域。",
        "5": "数量为0。"
      },
      "suggestions": [
        "清理异常连接边。",
        "删除内部重复面。",
        "重新合并或拆分异常顶点。"
      ]
    },
    {
      "id": "MH_DUPLICATE",
      "dimensionId": "MESH_HEALTH",
      "name": "重复几何",
      "description": "检测重复顶点、重复边、重叠面和完全相同的重复面。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "duplicateVertexCount",
        "duplicateFaceCount",
        "overlappingFaceCount"
      ],
      "scoreCriteria": {
        "0": "重复几何覆盖主体模型。",
        "1": "大量重复面或重叠结构。",
        "2": "重复几何明显影响法线或编辑。",
        "3": "存在少量重复面但可快速清理。",
        "4": "仅有少量孤立重复顶点。",
        "5": "无重复几何。"
      },
      "suggestions": [
        "合并阈值范围内的重复顶点。",
        "删除重叠面。",
        "检查镜像和复制操作残留。"
      ]
    },
    {
      "id": "MH_ZERO_AREA",
      "dimensionId": "MESH_HEALTH",
      "name": "零面积几何",
      "description": "检测零面积面、零长度边和重合顶点形成的无效几何。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "zeroAreaFaceCount",
        "zeroLengthEdgeCount"
      ],
      "scoreCriteria": {
        "0": "网格无法稳定处理。",
        "1": "大面积出现无效几何。",
        "2": "问题数量较多并影响三角化。",
        "3": "存在少量问题但不影响主体。",
        "4": "仅有极少量孤立问题。",
        "5": "无零面积面和零长度边。"
      },
      "suggestions": [
        "删除退化面。",
        "合并重合顶点。",
        "重新构建局部网格。"
      ]
    },
    {
      "id": "MH_HOLES",
      "dimensionId": "MESH_HEALTH",
      "name": "非设计性破洞",
      "description": "识别模型中非预期的开放边界、缺失面和破损区域。",
      "evaluationType": "HYBRID",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "CRITICAL",
      "metrics": [
        "boundaryLoopCount",
        "unexpectedHoleCount",
        "holeAreaRatio"
      ],
      "scoreCriteria": {
        "0": "模型严重破损或不完整。",
        "1": "主体存在大面积缺失。",
        "2": "破洞影响主体表面连续性。",
        "3": "存在少量可修补破洞。",
        "4": "存在极小且低风险的开放区域。",
        "5": "不存在非设计性破洞。"
      },
      "suggestions": [
        "确认开放边是否为设计结构。",
        "填补非预期破洞。",
        "重新生成破损区域拓扑。"
      ]
    },
    {
      "id": "MH_INTERSECTION",
      "dimensionId": "MESH_HEALTH",
      "name": "自相交",
      "description": "检测模型自身表面之间的非设计性穿插和交叉。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "selfIntersectionCount",
        "intersectionAreaRatio"
      ],
      "scoreCriteria": {
        "0": "模型主体严重纠缠。",
        "1": "大面积自相交。",
        "2": "多处穿插影响表面或烘焙。",
        "3": "存在少量局部穿插。",
        "4": "仅存在极少量边界接触。",
        "5": "无非设计性自相交。"
      },
      "suggestions": [
        "分离穿插表面。",
        "删除内部无效几何。",
        "重新调整局部轮廓。"
      ]
    },
    {
      "id": "MH_NORMAL_DIRECTION",
      "dimensionId": "MESH_HEALTH",
      "name": "法线方向一致性",
      "description": "检测反向法线、法线方向不一致和局部翻面。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "CRITICAL",
      "metrics": [
        "flippedFaceCount",
        "flippedFaceRatio",
        "normalIslandCount"
      ],
      "scoreCriteria": {
        "0": "无法建立可靠内外方向。",
        "1": "大面积法线翻转。",
        "2": "局部区域法线明显混乱。",
        "3": "少量翻面可快速修复。",
        "4": "仅有极少量孤立翻面。",
        "5": "法线方向完全一致。"
      },
      "suggestions": [
        "统一法线方向。",
        "检查负缩放和镜像结果。",
        "重新计算顶点法线。"
      ]
    },
    {
      "id": "MH_ISOLATED",
      "dimensionId": "MESH_HEALTH",
      "name": "孤立几何",
      "description": "检测无用途的孤立顶点、孤立边和微小独立面片。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MINOR",
      "metrics": [
        "isolatedVertexCount",
        "isolatedEdgeCount",
        "smallShellCount"
      ],
      "scoreCriteria": {
        "0": "模型主要由无组织碎片组成。",
        "1": "大量碎片化几何。",
        "2": "孤立结构较多并影响管理。",
        "3": "存在少量可清理的小面片。",
        "4": "仅有少量孤立顶点。",
        "5": "无无效孤立几何。"
      },
      "suggestions": [
        "删除无效孤立元素。",
        "确认独立部件是否属于设计结构。",
        "合并需要保留的小型组件。"
      ]
    },
    {
      "id": "MH_DEGENERATE",
      "dimensionId": "MESH_HEALTH",
      "name": "薄片与退化面",
      "description": "检测极窄、极扭曲或几何质量过差的三角面和多边形。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "degenerateFaceCount",
        "sliverTriangleRatio",
        "minimumFaceAngle"
      ],
      "scoreCriteria": {
        "0": "网格整体不稳定。",
        "1": "大量细长或折叠面。",
        "2": "退化面造成阴影或编辑问题。",
        "3": "局部存在细长面但不影响表面。",
        "4": "仅有极少量细长面。",
        "5": "无明显退化面。"
      },
      "suggestions": [
        "重新分配局部顶点。",
        "合并过短边。",
        "避免极端长宽比三角面。"
      ]
    },
    {
      "id": "SF_SILHOUETTE",
      "dimensionId": "SHAPE_FIDELITY",
      "name": "主轮廓保留",
      "description": "比较正面、侧面、顶部和透视角度下的高低模外轮廓。",
      "evaluationType": "HYBRID",
      "applicableModes": [
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "silhouetteIoU",
        "silhouetteDistanceMean",
        "silhouetteDistanceMax"
      ],
      "scoreCriteria": {
        "0": "无法识别原始形体。",
        "1": "主体轮廓严重改变。",
        "2": "多个关键轮廓明显失真。",
        "3": "部分轮廓出现可见简化。",
        "4": "存在轻微偏差但不影响识别。",
        "5": "主要视角轮廓高度一致。"
      },
      "suggestions": [
        "在外轮廓转折处增加顶点。",
        "减少平面内部无效面数。",
        "优先修复高可见视角轮廓。"
      ]
    },
    {
      "id": "SF_PRIMARY_VOLUME",
      "dimensionId": "SHAPE_FIDELITY",
      "name": "一级体积保留",
      "description": "比较模型整体长宽高、主体体积和大型比例关系。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "boundingBoxDeviation",
        "volumeDeviationRatio",
        "principalAxisDeviation"
      ],
      "scoreCriteria": {
        "0": "主体体积无法对应。",
        "1": "整体比例严重失真。",
        "2": "主体体积明显塌陷或膨胀。",
        "3": "部分比例有可见偏差。",
        "4": "存在轻微体积变化。",
        "5": "整体体积和比例高度一致。"
      },
      "suggestions": [
        "恢复主要体块比例。",
        "检查自动投射距离。",
        "避免平均化关键体积。"
      ]
    },
    {
      "id": "SF_SECONDARY_FORM",
      "dimensionId": "SHAPE_FIDELITY",
      "name": "二级形体保留",
      "description": "分析大型凹凸结构、转折和次级体块是否得到保留。",
      "evaluationType": "AI_VISUAL",
      "applicableModes": [
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "secondaryFormRetentionScore"
      ],
      "scoreCriteria": {
        "0": "低模仅剩粗略外壳。",
        "1": "大部分次级形体丢失。",
        "2": "多个重要结构被削平。",
        "3": "部分次级体块变弱。",
        "4": "少量次级结构略有简化。",
        "5": "次级形体完整且清晰。"
      },
      "suggestions": [
        "为重要凹凸结构保留几何。",
        "删除不能被当前面数表达的微小噪声。",
        "优先保留影响识别的次级形体。"
      ]
    },
    {
      "id": "SF_LANDMARKS",
      "dimensionId": "SHAPE_FIDELITY",
      "name": "关键特征点保留",
      "description": "检测突起、凹陷、开口、边缘和标志性结构是否被保留。",
      "evaluationType": "AI_VISUAL",
      "applicableModes": [
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "landmarkRetentionRatio",
        "missingLandmarkCount"
      ],
      "scoreCriteria": {
        "0": "模型失去主要识别性。",
        "1": "多个识别特征消失。",
        "2": "重要特征缺失或位置偏移。",
        "3": "部分特征明显简化。",
        "4": "仅有非核心特征略有损失。",
        "5": "所有关键特征点均被准确保留。"
      },
      "suggestions": [
        "提高关键特征周围面密度。",
        "将极点移出关键特征中心。",
        "为开口和锐利转折建立结构环线。"
      ]
    },
    {
      "id": "SF_CURVATURE",
      "dimensionId": "SHAPE_FIDELITY",
      "name": "曲率连续性",
      "description": "判断曲面是否出现不合理折断、塌陷、鼓包或曲率突变。",
      "evaluationType": "HYBRID",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "curvatureDiscontinuityCount",
        "curvatureVariance",
        "surfaceKinkCount"
      ],
      "scoreCriteria": {
        "0": "表面形体严重失效。",
        "1": "曲面大面积塌陷或鼓包。",
        "2": "多个区域出现明显折断。",
        "3": "局部曲率过渡较生硬。",
        "4": "存在少量轻微折线。",
        "5": "曲率变化自然连续。"
      },
      "suggestions": [
        "调整高曲率区域顶点位置。",
        "增加必要的轮廓支撑点。",
        "减少密度突变。"
      ]
    },
    {
      "id": "SF_DEVIATION",
      "dimensionId": "SHAPE_FIDELITY",
      "name": "高低模表面偏差",
      "description": "计算低模表面相对于参考模型的平均距离、最大距离和超阈值区域。",
      "evaluationType": "AUTOMATIC",
      "applicableModes": [
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "meanSurfaceDeviation",
        "maxSurfaceDeviation",
        "outlierAreaRatio"
      ],
      "scoreCriteria": {
        "0": "高低模基本不对应。",
        "1": "大面积无法贴合参考模型。",
        "2": "多个关键区域偏差明显。",
        "3": "部分区域超过建议阈值。",
        "4": "少量局部偏差。",
        "5": "表面偏差极低且分布稳定。"
      },
      "suggestions": [
        "重新投射低模顶点。",
        "重点修复偏差热力图中的高值区域。",
        "区分设计性简化和错误偏移。"
      ]
    },
    {
      "id": "EF_CURVATURE",
      "dimensionId": "EDGE_FLOW",
      "name": "曲率跟随",
      "description": "判断边线是否沿曲面主要弯曲方向和形体变化方向组织。",
      "evaluationType": "AI_VISUAL",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "edgeCurvatureAlignmentScore"
      ],
      "scoreCriteria": {
        "0": "边流完全随机。",
        "1": "边线大面积横切主要形体。",
        "2": "多个高曲率区域边流错误。",
        "3": "边流基本可读但不够稳定。",
        "4": "少量区域方向略有偏差。",
        "5": "边流清晰跟随主要曲率。"
      },
      "suggestions": [
        "沿主要曲率方向重定向边线。",
        "避免在曲率中心形成杂乱极点。",
        "减少无功能的对角边。"
      ]
    },
    {
      "id": "EF_FEATURE",
      "dimensionId": "EDGE_FLOW",
      "name": "特征跟随",
      "description": "判断边流是否围绕开口、凹槽、凸起、硬边和结构分区进行组织。",
      "evaluationType": "AI_VISUAL",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "featureAlignmentScore"
      ],
      "scoreCriteria": {
        "0": "边流与模型特征无关。",
        "1": "特征区域结构混乱。",
        "2": "多个重要特征缺乏边流支持。",
        "3": "部分结构得到表达。",
        "4": "非核心特征附近略有偏差。",
        "5": "边流完整表达关键结构。"
      },
      "suggestions": [
        "围绕开口建立闭合边流。",
        "沿硬表面转折建立结构边。",
        "确保关键特征可被单独编辑。"
      ]
    },
    {
      "id": "EF_CONTINUITY",
      "dimensionId": "EDGE_FLOW",
      "name": "边流连续性",
      "description": "检测边带是否无意义中断、反复转向或突然改变密度。",
      "evaluationType": "HYBRID",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "edgeFlowBreakCount",
        "directionChangeVariance"
      ],
      "scoreCriteria": {
        "0": "无法识别有效边流。",
        "1": "边流碎片化严重。",
        "2": "多处突然终止或转向。",
        "3": "局部边流不够顺畅。",
        "4": "少量低风险中断。",
        "5": "边流连续且功能清晰。"
      },
      "suggestions": [
        "将环线终止在低风险区域。",
        "减少短边链。",
        "统一相邻区域边流方向。"
      ]
    },
    {
      "id": "EF_RANDOMNESS",
      "dimensionId": "EDGE_FLOW",
      "name": "边流随机性控制",
      "description": "检测无规律锯齿边、随机三角化、扭曲面和缺乏方向性的连接。",
      "evaluationType": "AI_VISUAL",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "topologyRandomnessScore",
        "irregularEdgeRatio"
      ],
      "scoreCriteria": {
        "0": "接近无规则三角网格。",
        "1": "大面积拓扑随机。",
        "2": "多个区域出现明显锯齿或乱线。",
        "3": "局部存在随机感。",
        "4": "仅有少量不规则连接。",
        "5": "拓扑规律清晰。"
      },
      "suggestions": [
        "重建随机三角区域。",
        "减少不必要的边方向变化。",
        "按形体分区重新规划拓扑。"
      ]
    },
    {
      "id": "EF_POLE_PLACEMENT",
      "dimensionId": "EDGE_FLOW",
      "name": "极点位置",
      "description": "判断高价顶点和环线汇聚点是否位于平坦、低变形和低视觉风险区域。",
      "evaluationType": "HYBRID",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MAJOR",
      "metrics": [
        "poleCountByValence",
        "highRiskPoleCount",
        "poleCurvatureCorrelation"
      ],
      "scoreCriteria": {
        "0": "极点结构导致表面失效。",
        "1": "极点集中造成明显夹痕。",
        "2": "多个极点位于关键曲率或轮廓。",
        "3": "存在可接受但不理想的极点。",
        "4": "少量极点接近高曲率区域。",
        "5": "极点数量和位置合理。"
      },
      "suggestions": [
        "将极点移动到平坦区域。",
        "避免极点位于轮廓和关键特征中心。",
        "重新分流过度汇聚的环线。"
      ]
    },
    {
      "id": "EF_DIRECTION",
      "dimensionId": "EDGE_FLOW",
      "name": "结构方向性",
      "description": "判断拓扑是否体现模型的主要轴向、结构方向和潜在运动方向。",
      "evaluationType": "AI_VISUAL",
      "applicableModes": [
        "LOW_POLY_ONLY",
        "REFERENCE_COMPARISON"
      ],
      "defaultSeverity": "MINOR",
      "metrics": [
        "structuralDirectionScore"
      ],
